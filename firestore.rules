rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // القراءة العامة للمجموعات العامة
    match /services/{document} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
    match /products/{document} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
    match /portfolio/{document} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
    match /blog/{document} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // الطلبات — العميل يقرأ طلباته فقط، المشرف يقرأ الكل ويكتب
    match /orders/{document} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow write: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow create: if request.auth != null;
    }

    // المستخدمين — العميل يقرأ ويكتب بياناته فقط، المشرف يقرأ الكل
    match /users/{document} {
      allow read: if request.auth != null && (request.auth.uid == document || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == document;
    }

    // سجل التدقيق — فقط المشرف يقرأ
    match /audit_logs/{document} {
      allow read: if request.auth.token.admin == true;
      allow write: if false;
    }

    // المفضلة — العميل يقرأ ويكتب مفضلاته فقط
    match /favorites/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // منتجات المستخدم
    match /user_products/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
  }
}
