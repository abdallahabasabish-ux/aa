rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolio/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /user_products/{docId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /favorites/{docId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
