rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ========== USERS ==========
    match /users/{uid} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(uid));
      allow write: if isAuthenticated() && (isAdmin() || isOwner(uid));
    }

    // ========== ADMINS ==========
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========== PUBLIC COLLECTIONS (Readable by all, writable by Admin) ==========
    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /service_packages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /templates/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /portfolio/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /posts/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /site_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== ORDERS (Users create their own, Admin full access) ==========
    match /orders/{id} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (isAdmin() || isOwner(request.resource.data.userId));
      allow update: if isAdmin() || (isAuthenticated() && isOwner(request.resource.data.userId));
      allow delete: if isAdmin();
    }

    // ========== REVIEWS (Public read approved only, User create own, Admin manage) ==========
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(request.resource.data.userId));
      allow create, update, delete: if isAdmin();
    }

    // ========== CONTACT MESSAGES ==========
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ========== AUDIT LOGS ==========
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
