rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // القراءة العامة للبيانات النشطة
    match /services/{id} { allow read: if resource.data.active == true; allow write: if isAdmin(); }
    match /templates/{id} { allow read: if resource.data.active == true; allow write: if isAdmin(); }
    match /products/{id} { allow read: if resource.data.active == true; allow write: if isAdmin(); }
    match /portfolio/{id} { allow read: if resource.data.active == true; allow write: if isAdmin(); }
    match /posts/{id} { allow read: if resource.data.status == 'published'; allow write: if isAdmin(); }
    match /reviews/{id} { allow read: if resource.data.status == 'approved'; allow write: if isAuthenticated(); }
    match /orders/{id} { allow create: if isAuthenticated(); allow read: if isAdmin() || isOwner(resource.data.userId); }
    match /users/{id} { allow read, write: if request.auth.uid == id || isAdmin(); }
    match /admins/{id} { allow read, write: if isAdmin(); }
    match /contact_messages/{id} { allow create: if true; allow read: if isAdmin(); }
    match /site_settings/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
