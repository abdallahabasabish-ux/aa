rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // سماح القراءة للعامة (للعرض في الموقع)
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // الكتابة (رفع/تعديل/حذف) فقط للمشرفين
    match /{allPaths=**} {
      allow write: if request.auth != null && 
                   exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
